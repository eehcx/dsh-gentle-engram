{
  "name": "dsh-gentle-engram",
  "version": "0.4.0",
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "description": "Cordis Host integration for Engram persistent memory in DeepSeek Harness",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "CONTRIBUTING.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/eehcx/dsh-gentle-engram.git"
  },
  "bugs": {
    "url": "https://github.com/eehcx/dsh-gentle-engram/issues"
  },
  "homepage": "https://github.com/eehcx/dsh-gentle-engram#readme",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "engram",
    "persistent-memory"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.cts",
      "default": "./dist/client.cjs"
    },
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "test": "pnpm run build && node --test",
    "prepublishOnly": "pnpm run typecheck && pnpm run build && npm pack --dry-run",
    "release:check": "pnpm run typecheck && pnpm run build && npm pack --dry-run",
    "release:alpha": "pnpm publish --access public --tag alpha",
    "release:stable": "pnpm publish --access public --tag latest"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1 || ~4.0.6-alpha.1",
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.2 || ^0.2.2-alpha.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "^3.19.0",
    "@types/node": "^26.6.6",
    "@types/react": "~19.3.0",
    "react": "^19.3.1",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2"
  }
}
